+static void ui_wave_icon(const MelloUiDrawOps *o, int16_t x, int16_t y, int16_t w, int16_t h, MelloWaveform wave, uint16_t colour)
+{
+    static const uint8_t sine16[16] = {8u,5u,3u,1u,0u,1u,3u,5u,8u,11u,13u,15u,16u,15u,13u,11u};
+    uint8_t i;
+    if (w < 16 || h < 8) return;
+    o->fill(o->ctx, x, y, w, h, UI_PANEL);
+    ui_frame(o, x, y, w, h, wave == MELLO_WAVE_OFF ? UI_DIM : UI_PANEL2);
+    if (wave == MELLO_WAVE_OFF) return;
+    for (i = 0u; i < 24u; ++i) {
+        int16_t px = (int16_t)(x + 4 + ((int32_t)i * (w - 8)) / 24);
+        int16_t py;
+        uint8_t ph = (uint8_t)((i * 16u) / 24u);
+        if (wave == MELLO_WAVE_SAW) py = (int16_t)(y + 4 + ((int32_t)(i % 12u) * (h - 9)) / 11);
+        else if (wave == MELLO_WAVE_SQUARE) py = (int16_t)(y + ((i % 12u) < 6u ? 5 : h - 6));
+        else if (wave == MELLO_WAVE_TRIANGLE) { uint8_t q=(uint8_t)(i%12u); uint8_t t=q<6u?q:(uint8_t)(11u-q); py=(int16_t)(y+h-5-((int32_t)t*(h-10))/5); }
+        else if (wave == MELLO_WAVE_PULSE) py = (int16_t)(y + ((i % 12u) < 3u ? 5 : h - 6));
+        else py = (int16_t)(y + 4 + ((int32_t)sine16[ph] * (h - 9)) / 16);
+        o->fill(o->ctx, px, py, 3, 2, colour);
+    }
+}
