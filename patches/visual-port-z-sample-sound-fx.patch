+static void ui_env_graph(const MelloUiDrawOps *o, int16_t x, int16_t y, int16_t w, int16_t h,
+                         uint16_t attack, uint16_t decay, uint16_t sustain, uint16_t release, uint16_t colour)
+{
+    uint32_t total=(uint32_t)attack+decay+release+500u;
+    int16_t ax=(int16_t)(4+((uint32_t)(w-8)*attack)/total);
+    int16_t dx=(int16_t)(4+((uint32_t)(w-8)*decay)/total);
+    int16_t sx=(int16_t)(4+((uint32_t)(w-8)*500u)/total);
+    int16_t rx=(int16_t)(w-8-ax-dx-sx);
+    int16_t peak=(int16_t)(y+4), base=(int16_t)(y+h-5), sus;
+    uint8_t i;
+    if (rx < 2) rx = 2;
+    sus=(int16_t)(base-((int32_t)(base-peak)*(sustain>1000u?1000u:sustain))/1000);
+    o->fill(o->ctx,x,y,w,h,UI_PANEL); ui_frame(o,x,y,w,h,UI_PANEL2);
+    /* Sparse 32-point trace: enough for a 240 px display without a costly per-pixel redraw. */
+    for(i=0u;i<32u;++i){
+        int16_t col=(int16_t)(((int32_t)i*(w-9))/31);
+        int16_t py;
+        if(col<ax) py=(int16_t)(base-((int32_t)(base-peak)*col)/(ax?ax:1));
+        else if(col<ax+dx) py=(int16_t)(peak+((int32_t)(sus-peak)*(col-ax))/(dx?dx:1));
+        else if(col<ax+dx+sx) py=sus;
+        else py=(int16_t)(sus+((int32_t)(base-sus)*(col-ax-dx-sx))/(rx?rx:1));
+        if(py<peak)py=peak;
+        if(py>base)py=base;
+        o->fill(o->ctx,(int16_t)(x+4+col),py,3,2,colour);
+    }
+}
